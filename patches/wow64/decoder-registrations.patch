-		    { NULL }
-		},
-	    },
-	    { 0xFFFFFFFF },
-	}
-    },
-    { NULL }		/* list terminator */
-};
-
 extern HRESULT WINAPI QUARTZ_DllRegisterServer(void);
 extern HRESULT WINAPI QUARTZ_DllUnregisterServer(void);
 
@@ -265,13 +45,162 @@ extern HRESULT WINAPI QUARTZ_DllUnregisterServer(void);
