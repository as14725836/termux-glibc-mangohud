+/***********************************************************************
+ *           init_dns_config
+ *
+ * Termux glibc reads resolv.conf under its own prefix, not the regular
+ * Termux etc directory. Use the same path for checking and creating it.
+ */
+static void init_dns_config(void)
+{
+    const char *resolv_path = WINE_TGMUX_PATH( "/etc/resolv.conf" );
+    const char *dns_server;
+    FILE *f;
+
+    if (!access( resolv_path, R_OK )) return;
+
+    /* Limit resolver delays even if the config cannot be created. */
+    setenv( "RES_OPTIONS", "timeout:1 attempts:1", 0 );
+    if (!(dns_server = getenv( "WINE_DNS_SERVER" ))) dns_server = "8.8.8.8";
+    if (!(f = fopen( resolv_path, "w" ))) return;
+
+    fprintf( f, "# Auto-generated by Wine for Termux\n" );
+    fprintf( f, "nameserver %s\n", dns_server );
+    fprintf( f, "nameserver 1.1.1.1\n" );
+    fclose( f );
+}
+
 
 
 /***********************************************************************
