+static bool amt_to_wg_format_audio_mpeg4(const AM_MEDIA_TYPE *mt, struct wg_format *format)
+{
+    static const size_t waveinfo_size = sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX);
+    const WAVEFORMATEX *audio_format = (const WAVEFORMATEX *)mt->pbFormat;
+    DWORD codec_data_len;
+
+    if (!IsEqualGUID(&mt->formattype, &FORMAT_WaveFormatEx)
+            || mt->cbFormat < sizeof(WAVEFORMATEX) || !mt->pbFormat)
+        return false;
+
+    codec_data_len = audio_format->cbSize;
+    if (codec_data_len > mt->cbFormat - sizeof(WAVEFORMATEX))
+        codec_data_len = mt->cbFormat - sizeof(WAVEFORMATEX);
+
+    format->major_type = WG_MAJOR_TYPE_AUDIO_MPEG4;
+    format->u.audio.channels = audio_format->nChannels;
+    format->u.audio.rate = audio_format->nSamplesPerSec;
+    format->u.audio.bitrate = audio_format->nAvgBytesPerSec * 8;
+    format->u.audio.payload_type = 0;
+
+    if (codec_data_len + waveinfo_size > sizeof(format->u.audio.codec_data))
+        codec_data_len = sizeof(format->u.audio.codec_data) - waveinfo_size;
+
+    format->u.audio.codec_data_len = codec_data_len + waveinfo_size;
+    memset(format->u.audio.codec_data, 0, waveinfo_size);
+    if (codec_data_len)
+        memcpy(format->u.audio.codec_data + waveinfo_size, audio_format + 1, codec_data_len);
+
+    return true;
+}
