+static bool amt_to_wg_format_video_h264(const AM_MEDIA_TYPE *mt, struct wg_format *format)
+{
+    const VIDEOINFOHEADER2 *video_format = (const VIDEOINFOHEADER2 *)mt->pbFormat;
+    DWORD codec_data_len;
+
+    if (!IsEqualGUID(&mt->formattype, &FORMAT_VideoInfo2)
+            || mt->cbFormat < sizeof(VIDEOINFOHEADER2) || !mt->pbFormat)
+        return false;
+
+    codec_data_len = video_format->bmiHeader.biSize > sizeof(BITMAPINFOHEADER)
+            ? video_format->bmiHeader.biSize - sizeof(BITMAPINFOHEADER) : 0;
+    if (codec_data_len > mt->cbFormat - sizeof(VIDEOINFOHEADER2))
+        codec_data_len = mt->cbFormat - sizeof(VIDEOINFOHEADER2);
+    if (codec_data_len > sizeof(format->u.video.codec_data))
+        codec_data_len = sizeof(format->u.video.codec_data);
+
+    format->major_type = WG_MAJOR_TYPE_VIDEO_H264;
+    format->u.video.width = video_format->bmiHeader.biWidth;
+    format->u.video.height = video_format->bmiHeader.biHeight;
+    if (video_format->AvgTimePerFrame)
+    {
+        format->u.video.fps_n = 10000000;
+        format->u.video.fps_d = video_format->AvgTimePerFrame;
+    }
+    format->u.video.codec_data_len = codec_data_len;
+    if (codec_data_len)
+        memcpy(format->u.video.codec_data, video_format + 1, codec_data_len);
+
+    return true;
+}
