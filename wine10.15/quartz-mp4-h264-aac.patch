+static bool amt_from_wg_format_audio_mpeg4(AM_MEDIA_TYPE *mt, const struct wg_format *format)
+{
+    static const size_t waveinfo_size = sizeof(HEAACWAVEINFO) - sizeof(WAVEFORMATEX);
+    WAVEFORMATEX *wave_format;
+    DWORD extra_len, size;
+
+    /* The codec data stored by the unix side is a HEAACWAVEINFO extension
+     * followed by the AudioSpecificConfig. DirectShow AAC decoders expect
+     * only the AudioSpecificConfig after the WAVEFORMATEX. */
+    extra_len = format->u.audio.codec_data_len > waveinfo_size
+            ? format->u.audio.codec_data_len - waveinfo_size
+            : format->u.audio.codec_data_len;
+
+    size = sizeof(WAVEFORMATEX) + extra_len;
+    if (!(wave_format = CoTaskMemAlloc(size)))
+        return false;
+    memset(wave_format, 0, size);
+
+    mt->majortype = MEDIATYPE_Audio;
+    mt->subtype = MEDIASUBTYPE_RAW_AAC1;
+    mt->bFixedSizeSamples = TRUE;
+    mt->lSampleSize = 1;
+    mt->formattype = FORMAT_WaveFormatEx;
+    mt->cbFormat = size;
+    mt->pbFormat = (BYTE *)wave_format;
+    wave_format->wFormatTag = WAVE_FORMAT_RAW_AAC1;
+    wave_format->nChannels = format->u.audio.channels;
+    wave_format->nSamplesPerSec = format->u.audio.rate;
+    wave_format->nAvgBytesPerSec = format->u.audio.bitrate / 8;
+    wave_format->nBlockAlign = 1;
+    wave_format->wBitsPerSample = 16;
+    wave_format->cbSize = extra_len;
+
+    if (extra_len)
+        memcpy(wave_format + 1, format->u.audio.codec_data + waveinfo_size, extra_len);
+
+    return true;
+}
